# Neu Box Runtime configuration -- documentation of the keys, not an installed
# file.
#
# Read by both neu-box-runtime (the runc wrapper) and neu-box-hook (the OCI
# hook that registers containers with the Worker).  The live file is
# /etc/neu-box/runtime.env: neu-box-config generates and migrates it (and
# scripts/install.sh calls neu-box-config).  The RPM does NOT ship this file --
# a config written by both a package template and a deployment script has two
# writers and therefore no owner.
#
# This is the "runtime" role of the project-wide convention
# /etc/neu-box/<role>.env (see src/neu_box/config.py:load_role_environment in
# the worker repo).  It is a separate file from worker.env on purpose: the two
# binaries ship in their own package and must not fight over one config file.
#
# Any NEU_BOX_* environment variable overrides the value in this file; that
# layer exists for debugging and temporary overrides, not for production --
# the hook inherits dockerd's environment, so `docker run -e` cannot reach it.
# NEU_BOX_CONFIG=<path> points both binaries at a different file entirely.

# Worker HTTP endpoint used by neu-box-hook to register containers.
# The port must match NEU_BOX_PORT in worker.env -- two files describing the
# same fact; scripts/install.sh reads the port from worker.env when generating
# this file.
NEU_BOX_WORKER_URL=http://127.0.0.1:59075

# Absolute path of the hook the wrapper injects into the OCI bundle's
# config.json.
NEU_BOX_HOOK=/usr/local/bin/neu-box-hook

# OCI hook phase the wrapper injects into.
#
# createRuntime is the spec's replacement for the deprecated prestart (which
# runc will drop eventually) and was verified on real hardware by driving runc
# directly (`runc run -b`, no dockerd): the hook runs, sees the container's mnt
# ns (mnt:[4026549739] != the hook's own mnt:[4026531841]) and cgroup scope,
# and a non-zero exit still blocks the payload.  The phase is runc's own
# behaviour and Docker/containerd only pick the runtime binary, so that is the
# layer where it needed verifying.
#
# prestart is NOT dead code: it is the only phase verified over the whole Docker
# chain (Docker 28.5.2 / containerd 1.7.28 / runc 1.3.3).  Running createRuntime
# through that whole chain has not been done yet, and the first real install
# will be that run.  If something breaks, switching back to prestart is the way
# out -- that is what this switch is for.
NEU_BOX_HOOK_PHASE=createRuntime

# The runtime the wrapper forwards to after injecting.  Configurable because
# Ascend Docker Runtime will eventually sit behind this wrapper instead of
# runc.
NEU_BOX_REAL_RUNC=/usr/local/bin/runc

# Capability guard for the Ascend driver's "admin container" judgement.
#
# The driver (cann/driver, src/sdk_driver/pbl/uda/uda_access.c) treats a
# container as an *admin* namespace when its effective capabilities are a
# superset of ka_system_get_privileged_kernel_cap() -- on 6.3+ kernels that
# mask is bits 0..37, i.e. every capability from CAP_CHOWN to CAP_AUDIT_READ.
# Only --privileged / --cap-add=ALL reach that.  An admin namespace gets a
# FULL UDA device table built for its mount namespace (all physical cards),
# which bypasses the worker's eBPF device filter entirely: isolation silently
# disappears (measured: torch.npu.device_count() == 8 inside a container that
# had reserved exactly 2 cards).
#
# drop (default) removes one bit -- CAP_AUDIT_READ, the one containers never
# need -- from bounding/permitted/effective/ambient, which drops the container
# out of the admin superset while keeping everything else.  The container then
# follows the intended path: registered containers see exactly their sandbox's
# cards, unregistered ones see none (fail-closed).
#
# deny refuses to create such a container instead (use it when you would rather
# fail loudly than adjust a requested capability set).  off disables the guard
# -- troubleshooting only.
NEU_BOX_CAP_GUARD=drop
